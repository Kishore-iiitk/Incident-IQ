# IncidentIQ Environment Variables Configuration

# Server Port
PORT=5000

# Client URL (for CORS and Socket.IO)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas or Local MongoDB Connection String
# (If omitted in development/testing, an embedded in-memory MongoDB will run automatically)
MONGODB_URI=mongodb://localhost:27017/incidentiq

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Names
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_STRONG=gemini-2.5-pro

# Python ML Microservice URL (FastAPI)
ML_SERVICE_URL=http://localhost:8000

# Demo Mode (default: false)
# When true, serves real recorded pipeline outputs from recorded cache with UI badge
DEMO_MODE=false
