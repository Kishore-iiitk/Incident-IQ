# IncidentIQ Environment Variables Configuration

# Server Port & Client URL
PORT=5000
CLIENT_URL=http://localhost:5173

# IncidentIQ Backend URL for Collectors
INCIDENTIQ_URL=http://localhost:5000/incidents

# MongoDB Connection String for IncidentIQ
# (If omitted in development/testing, an embedded in-memory MongoDB runs automatically)
MONGODB_URI=mongodb://localhost:27017/incidentiq

# Google Gemini API Key and Models
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_STRONG=gemini-3.1-pro-preview

# Python ML Microservice URL (FastAPI running on port 8001)
ML_SERVICE_URL=http://localhost:8001

# Demo Mode (default: false)
# When true, serves real recorded pipeline outputs from recorded cache with UI badge
DEMO_MODE=false

# Demo-LMS Service Configuration
DEMO_LMS_PORT=4100
DEMO_LMS_URL=http://localhost:4100
DEMO_LMS_MONGO_URI=mongodb://localhost:27017/demo_lms
DEMO_LMS_LOG_PATH=demo-lms/logs/app.log

# Fault Injection Controls
FAULT_KEY=demo-fault-secret-key
FAULT_SLOW_MS=4000

# Collector Telemetry Controls
ENABLE_POLLER=true
ENABLE_LOG_WATCHER=true
HEALTH_POLL_INTERVAL_MS=30000
SLOW_THRESHOLD_MS=2000
